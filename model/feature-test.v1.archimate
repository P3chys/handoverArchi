        <child xsi:type="archimate:DiagramObject" id="d-jand" targetConnections="c-t4" archimateElement="j-and">
          <bounds x="900" y="60" width="15" height="15"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t5" source="d-jand" target="d-approve" archimateRelationship="r-t5"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t6" source="d-jand" target="d-notify" archimateRelationship="r-t6"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="d-approve" targetConnections="c-t5" archimateElement="e-approve">
          <bounds x="1300" y="20" width="120" height="55"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="d-notify" targetConnections="c-t6" archimateElement="e-notify">
          <bounds x="1300" y="140" width="120" height="55"/>
