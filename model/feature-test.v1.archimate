    </folder>
    <folder name="Claims" id="f-v-claims">
      <element xsi:type="archimate:ArchimateDiagramModel" name="Claim handling" id="v-claims">
        <documentation>Wide view (landscape PDF page) with junctions.</documentation>
        <child xsi:type="archimate:DiagramObject" id="d-recv" archimateElement="e-recv">
          <bounds x="20" y="100" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t1" source="d-recv" target="d-jor" archimateRelationship="r-t1"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="d-jor" targetConnections="c-t1" archimateElement="j-or">
          <bounds x="300" y="120" width="15" height="15"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t2" source="d-jor" target="d-check" archimateRelationship="r-t2"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t3" source="d-jor" target="d-reject" archimateRelationship="r-t3"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="d-check" targetConnections="c-t2" archimateElement="e-check">
          <bounds x="500" y="40" width="120" height="55"/>
          <sourceConnection xsi:type="archimate:Connection" id="c-t4" source="d-check" target="d-jand" archimateRelationship="r-t4"/>
        </child>
        <child xsi:type="archimate:DiagramObject" id="d-reject" targetConnections="c-t3" archimateElement="e-reject">
          <bounds x="500" y="180" width="120" height="55"/>
