    </folder>
    <element xsi:type="archimate:ArchimateDiagramModel" name="Applications" id="v-app">
      <child xsi:type="archimate:DiagramObject" id="d-core" archimateElement="e-core">
        <bounds x="200" y="20" width="300" height="160"/>
        <child xsi:type="archimate:DiagramObject" id="d-billing" archimateElement="e-billing">
          <bounds x="30" y="50" width="120" height="55"/>
